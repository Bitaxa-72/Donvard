{
  "name": "donvard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.js",
    "build": "vite build --config config/vite.config.js",
    "preview": "vite preview --config config/vite.config.js",
    "lint": "eslint --config config/eslint.config.js .",
    "lint:styles": "stylelint --config config/stylelint.config.mjs --ignore-path config/stylelintignore \"src/**/*.css\"",
    "format:check": "prettier --check --config config/prettier.config.json --ignore-path config/prettierignore \"**/*.html\" \"src/**/*.{js,css}\" \"config/**/*.{js,mjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "swiper": "^14.0.6",
    "vite-plugin-html-inject": "^1.1.2"
  }
}
